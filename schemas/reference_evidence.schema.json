{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/reference_evidence.schema.json",
  "title": "RTS Design Reference Evidence",
  "type": "object",
  "required": [
    "reference_id",
    "source_url",
    "captured_at",
    "artifact_type",
    "traits",
    "preference_evidence",
    "transferable_principles",
    "do_not_copy"
  ],
  "properties": {
    "reference_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "source_title": {"type": "string"},
    "source_name": {"type": "string"},
    "captured_at": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "sector": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "audience": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "traits": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "preference_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "description", "strength"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "award_or_curation",
              "expert_evaluation",
              "documented_design_system",
              "durable_adoption",
              "behavioral_signal",
              "user_preference_test",
              "project_human_approval",
              "other"
            ]
          },
          "description": {"type": "string", "minLength": 1},
          "strength": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
          "source_url": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "visual_observations": {"type": "array", "items": {"type": "string"}},
    "transferable_principles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "do_not_copy": {"type": "array", "items": {"type": "string"}},
    "license_or_usage_notes": {"type": "string"},
    "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "status": {"type": "string", "enum": ["ACTIVE", "REVIEW", "STALE", "REJECTED"]}
  },
  "additionalProperties": true
}
